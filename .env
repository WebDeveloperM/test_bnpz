# ═══════════════════════════════════════════════════════════════════════════
#  BnpzTest — MARKAZIY SOZLAMALAR NAMUNASI
#
#  Bu faylni ".env" nomi bilan nusxalab, qiymatlarni serveringizga moslang:
#      cp .env.example .env
#
#  Serverga ko'chirganda yoki IP o'zgarganda FAQAT ".env" faylini tahrirlang.
#  Loyihaning boshqa hech bir joyida IP manzil qattiq yozilmagan.
#  O'zgartirgandan keyin:  docker compose up -d --build
# ═══════════════════════════════════════════════════════════════════════════


# 1) Shu serverning (Docker ishlayotgan kompyuter) tarmoqdagi IP manzili.
#    Jonli ekran (proctoring) shu IP orqali uzatiladi.
SERVER_IP=192.168.101.214

# 2) BnpzId (employee_service) manzili — host:port. "/api/v1" avtomatik qo'shiladi.
BNPZID_HOST=192.168.101.6:5000
EMPLOYEE_SERVICE_API_KEY=dev-employee-service-key
EMPLOYEE_SERVICE_VERIFY_SSL=false

# 3) Django xavfsizligi. SECRET_KEY ni ALBATTA o'ziga xos qiymatga o'zgartiring:
#    python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE-ME-generate-a-random-50-char-secret
DJANGO_DEBUG=0

# 3a) PostgreSQL ma'lumotlar bazasi — TASHQI server (masalan pgAdmin bilan
#     boshqariladigan, Docker'dan mustaqil o'rnatilgan Postgres). docker-
#     compose.yml dagi "db" xizmati ENDI ISHLATILMAYDI (faqat eski ma'lumot
#     zaxirasi sifatida qoladi). DB_HOST — o'sha Postgres qaysi kompyuterda
#     ishlasa, shu manzil:
#       - agar Docker bilan BIR XIL kompyuterda, lekin Docker TASHQARISIDA
#         (native o'rnatma) bo'lsa: host.docker.internal
#       - agar BOSHQA kompyuterda bo'lsa: o'sha kompyuterning tarmoqdagi IP'si
#       - "localhost" HECH QACHON ishlamaydi (backend Docker konteyneri
#         ichida ishlaydi, "localhost" o'zini anglatadi)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=mytest
DB_USER=postgres
DB_PASSWORD=shMM1514!@#

# 3b) HTTP server (backend/serve.py). Odatda HECH NARSA YOZILMAYDI — standart
#     "waitress". Muammo bo'lsa eski serverga qaytish uchun quyidagini ochib,
#     `docker compose up -d backend` qiling (kod/image o'zgarmaydi):
# WSGI_SERVER=runserver

# 4) Tashqi dashboard uchun ochiq endpoint (/api/public/protocol/).
#    Bo'sh qoldirilsa — endpoint hech qanday kalit so'ramaydi.
#    Qiymat berilsa — so'rovda "X-Api-Key" sarlavhasi talab qilinadi.
#    Endpoint xodimning yuz/ekran videosini beradi, tabel raqami esa maxfiy
#    emas — imkon bo'lsa kalit qo'ying va so'rovni tashqi dashboardning
#    SERVERIDAN yuboring (brauzerdan emas, aks holda kalit ko'rinib qoladi).
PUBLIC_API_KEY=
